# Database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Service
SMTP_USERNAME=your_smtp_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# AWS Credentials — rotate immediately if exposed
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# AI - Gemini Google — rotate immediately if exposed
GEMINI_API_KEY=your_gemini_api_key

# Social - Facebook — rotate immediately if exposed
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_ACCESS_TOKEN=your_facebook_page_access_token
FB_REDIRECT_URI=https://yourdomain.com/api/v1/social/callback/facebook

# Social - LinkedIn — rotate immediately if exposed
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://yourdomain.com/api/v1/social/callback/linkedin

# Social - X (Twitter) — rotate immediately if exposed
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=https://yourdomain.com/api/v1/social/callback/x

# Payment - Razorpay — rotate immediately if exposed
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Security — rotate immediately if exposed; JWT_SECRET min 64 hex chars, ENCRYPTION_SECRET must be exactly 16 chars for AES
JWT_SECRET=your_jwt_secret_min_64_hex_chars
ENCRYPTION_SECRET=your16charAESkey!

# Instagram Reel Testing
# Set to 'true' to bypass transcoding and test with original video (useful for debugging format issues)
INSTAGRAM_REEL_SKIP_TRANSCODE=false

# App
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
SENDER_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
OWNER_EMAIL=owner@yourdomain.com
USE_S3=true
